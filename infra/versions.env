# Pinned versions (design decision D8). One line per component, added by the unit that uses it.
# Each version is checked against the project's official release page when it is added.
# P1-U2: the tool that configures the nodes. Pinned in infra/ansible/requirements.txt.
ANSIBLE_CORE=2.21.5
# P1-U3: container runtime (each checked on the project release page on 2026-10-09)
CONTAINERD=2.3.6        # LTS line, supported until April 2028; supports Kubernetes 1.36 and 1.37
RUNC=1.5.2              # the version containerd 2.3 expects
CRI_TOOLS=1.36.0        # crictl, matches Kubernetes 1.36
# P1-U4: Kubernetes, package version from pkgs.k8s.io. 1.36.5 is the newest 1.36 patch (2026-10-10);
# 1.36 is used because Cilium 1.20 lists Kubernetes 1.33 to 1.36 only (see the P1 spec amendments).
KUBERNETES=1.36.5       # kubeadm, kubelet, kubectl 1.36.5-1.1, held
KUBERNETES_APT_KEY=DE15B14486CD377B9E876E1A234654DA9A296436   # expires 2026-12-29
# P1-U5: Cilium and the host tools (checked on the project release pages on 2026-10-10)
CILIUM=1.20.2           # chart and app version; lists Kubernetes 1.33 to 1.36
HELM=4.3.0              # host tool; Helm 4.3.x supports Kubernetes 1.34 to 1.37
CILIUM_CLI=0.20.1       # host tool
HUBBLE_CLI=1.20.2       # host tool
# P1-U6: Gateway API CRDs and storage (installed and confirmed on the cluster on 2026-10-14: CRD bundle-version v1.6.1, local-path image v0.0.37)
GATEWAY_API=1.6.1       # standard-channel CRDs; Cilium 1.20 supports this version
LOCAL_PATH=0.0.37       # local-path-provisioner
# P1-U7: monitoring (chart index refreshed and version read on 2026-10-14; kubeVersion >=1.25)
KUBE_PROMETHEUS_STACK=92.6.0   # chart; Prometheus Operator v0.94.1
# P2-U1: security scanners (versions and assets read from the project release pages on 2026-10-15)
KUBE_BENCH=0.16.0       # image docker.io/aquasec/kube-bench:v0.16.0 (tag checked on Docker Hub)
KUBE_BENCH_BENCHMARK=cis-1.12   # newest CIS profile in kube-bench 0.16.0; its version map stops at Kubernetes 1.34, so the profile is set by hand (cluster runs 1.36)
KUBESCAPE=4.0.16        # host tool; released 2026-10-14
KUBESCAPE_SHA256=fcf172f0d1fb5683379586bcf8875091da4d0d815bd304f8098d58be65ecab0d   # kubescape_4.0.16_linux_amd64, from the release's checksums.sha256 (cosign not installed, so integrity only)
KUBESCAPE_CONTROLS=v2.0.38      # regolibrary release the controls are downloaded from (2026-09-29); pinned so a re-scan uses the same controls
