# Pinned versions (design decision D8). One line per component, added by the unit that uses it.
# Each version is checked against the project's official release page when it is added.
# P1-U2: the tool that configures the nodes. Pinned in infra/ansible/requirements.txt.
ANSIBLE_CORE=2.21.5
# P1-U3: container runtime (each checked on the project release page on 2026-10-09)
CONTAINERD=2.3.6        # LTS line, supported until April 2028; supports Kubernetes 1.36 and 1.37
RUNC=1.5.2              # the version containerd 2.3 expects
CRI_TOOLS=1.37.0        # crictl, matches Kubernetes 1.37
# P1-U4: Kubernetes (stable v1.37.1 on 2026-10-09), package version from pkgs.k8s.io
KUBERNETES=1.37.1       # kubeadm, kubelet, kubectl 1.37.1-1.1, held
KUBERNETES_APT_KEY=DE15B14486CD377B9E876E1A234654DA9A296436   # expires 2026-12-29
